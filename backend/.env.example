# Coral Copilot — Backend Environment Variables
# Copy this file to .env and fill in the values.

# OpenAI API key (for GPT-4o agent + Whisper transcription)
OPENAI_API_KEY=sk-...

# Path to the coral binary (defaults to 'coral' on PATH)
CORAL_BIN=coral

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000

# Server port
PORT=8000
