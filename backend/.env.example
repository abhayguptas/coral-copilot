# Coral Copilot — Backend Environment Variables
# Copy this file to .env and fill in the values.

# OpenAI API key (for GPT-4o agent + Whisper transcription)
# If using Groq, provide your Groq API key here (gsk_...)
OPENAI_API_KEY=sk-...

# Optional: Override base URL to use Groq
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Optional: Override model (e.g., if using Groq)
# OPENAI_MODEL=llama-3.3-70b-versatile

# Path to the coral binary (defaults to 'coral' on PATH)
CORAL_BIN=coral

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000

# Server port
PORT=8000
